# Google Maps Platform (primary)
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional fallbacks
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# AI Travel Assistant — FREE Groq (recommended: no install, no card)
# https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Windows SSL/antivirus fix (local dev only)
AI_INSECURE_TLS=0

# Optional: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

# Reviews & feedback email notifications
ADMIN_NOTIFICATION_EMAIL=ersultan.zhaken@gmail.com
ADMIN_PHONE=87053092053

# Option A — Resend (https://resend.com, free tier, recommended)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Turkestan Travel <onboarding@resend.dev>

# Option B — Gmail SMTP (Google Account → Security → App passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ersultan.zhaken@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=Turkestan Travel <ersultan.zhaken@gmail.com>

# Without A or B, FormSubmit.co is tried as fallback (activate via first email)
